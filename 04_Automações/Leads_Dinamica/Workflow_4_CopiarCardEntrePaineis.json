      "parameters": {
        "jsCode": "// Payload real do PANEL_CARD_NEW: tudo em body.content.\nconst b = $input.first().json.body ?? $input.first().json;\nconst c = b.content ?? {};\nconst cardId    = c.id       ?? null;\nconst panelId   = c.panelId  ?? null;\nconst stepId    = c.stepId   ?? null;\nconst title     = c.title    ?? null;\nconst description = c.description ?? null;\nconst contacts  = Array.isArray(c.contacts) ? c.contacts : [];\nconst contactId = contacts.length ? contacts[0].id : null;\nreturn [{ json: { cardId, panelId, stepId, title, description, contactId } }];"
      },
