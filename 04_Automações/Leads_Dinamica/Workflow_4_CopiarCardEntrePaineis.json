      "name": "Cards no Painel Destino",
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "jsCode": "const norm = (s) => (s || '').normalize('NFD').replace(/[\\u0300-\\u036f]/g, '').toLowerCase().trim();\n\n// Card origem (dados completos)\nconst originCard = $('Get Card Origem').first().json || {};\nconst tagIds = Array.isArray(originCard.tagIds) ? originCard.tagIds : [];\nconst contactIds = Array.isArray(originCard.contactIds) ? originCard.contactIds : [];\nconst title = originCard.title ?? $('Extrair Evento').first().json.title ?? 'Lead';\nconst description = originCard.description ?? $('Extrair Evento').first().json.description ?? '';\n\n// Mapas de tags por nome\nconst origemTags = (($('Tags Painel Origem').first().json) || {}).tags || [];\nconst idToName = {}; origemTags.forEach(t => { idToName[t.id] = t.name; });\nconst destinoTags = (($('Tags Painel Destino').first().json) || {}).tags || [];\nconst nameToId = {}; destinoTags.forEach(t => { nameToId[norm(t.name)] = t.id; });\n\n// Mapeia tagIds do painel origem para painel destino (por nome)\nconst mappedTagIds = [];\nfor (const tid of tagIds) {\n  const nome = norm(idToName[tid] || '');\n  const destId = nome ? nameToId[nome] : null;\n  if (destId && !mappedTagIds.includes(destId)) mappedTagIds.push(destId);\n}\n\n// Verifica card existente no destino\nconst resp = $('Cards no Painel Destino').first().json;\nconst arr = Array.isArray(resp) ? resp : (resp.items ?? resp.data ?? resp.cards ?? []);\nconst existingCard = Array.isArray(arr) && arr.length ? arr[0] : null;\nconst hasCard = !!existingCard;\nconst existingCardId = hasCard ? (existingCard.id ?? null) : null;\nconst existingTagIds = hasCard && Array.isArray(existingCard.tagIds) ? existingCard.tagIds : [];\nconst existingDesc = hasCard ? (existingCard.description || '') : '';\n\n// Merge de tags (existentes + mapeadas) e descrição\nconst mergedTagIds = Array.from(new Set([...existingTagIds, ...mappedTagIds]));\nlet mergedDesc = description || '';\nif (existingDesc && description && !existingDesc.includes(description)) {\n  mergedDesc = existingDesc + '\\n\\n---\\n' + description;\n} else if (existingDesc && !description) {\n  mergedDesc = existingDesc;\n}\n\nreturn [{ json: {\n  hasCard, existingCardId,\n  title, description, mergedDesc,\n  mappedTagIds, mergedTagIds,\n  contactIds,\n  contactId: $('Extrair Evento').first().json.contactId\n} }];"
      },
