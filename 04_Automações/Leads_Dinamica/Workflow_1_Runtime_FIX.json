    {
      "parameters": {
        "jsCode": "// Junta a linha (config achatada da clínica) com os dados preparados.\n// 'alwaysOutputData' no node Supabase garante 1 item mesmo sem match.\nconst prep = $('Preparar Dados').first().json;\nconst row = $input.first().json || {};\n\nconst ativoBool = (row.ativo === true || String(row.ativo).toLowerCase() === 'true');\nif (!row.helena_company_id || !ativoBool) {\n  return [{ json: { ...prep, found: false } }];\n}\n\nconst mapaPorOrigem = {\n  FACEBOOK:  { tag_nome: row.fb_tag_nome,  panel_tag_id: row.fb_panel_tag_id,  contact_tag_id: row.fb_contact_tag_id },\n  INSTAGRAM: { tag_nome: row.ig_tag_nome,  panel_tag_id: row.ig_panel_tag_id,  contact_tag_id: row.ig_contact_tag_id },\n  ORGANICO:  { tag_nome: row.org_tag_nome, panel_tag_id: row.org_panel_tag_id, contact_tag_id: row.org_contact_tag_id }\n};\nconst temOrigem = !!(mapaPorOrigem[prep.origem] && mapaPorOrigem[prep.origem].panel_tag_id);\nconst mapa = (temOrigem ? mapaPorOrigem[prep.origem] : mapaPorOrigem['ORGANICO']) || {};\n\n// Valida GUID: só conta como etiqueta válida se for um UUID de verdade (evita 500 'System.Guid').\nconst guidRe = /^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i;\nconst contact_tag_id = guidRe.test(String(mapa.contact_tag_id || '')) ? mapa.contact_tag_id : null;\nconst panel_tag_id   = guidRe.test(String(mapa.panel_tag_id   || '')) ? mapa.panel_tag_id   : null;\n\nreturn [{ json: {\n  ...prep,\n  found: true,\n  clinica_nome: row.nome,\n  token: row.helena_token,\n  panel_id: row.panel_id,\n  step_id: row.step_id,\n  origem_aplicada: temOrigem ? prep.origem : 'ORGANICO',\n  tag_nome: mapa.tag_nome ?? null,\n  panel_tag_id,\n  contact_tag_id,\n  tem_contact_tag: !!contact_tag_id,\n  tem_panel_tag: !!panel_tag_id\n} }];"
      },
