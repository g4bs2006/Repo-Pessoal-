    {
      "parameters": {
        "method": "GET",
        "url": "https://api.wts.chat/core/v1/tag?PageSize=200",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "Authorization", "value": "=Bearer {{ $('Entradas').first().json.helena_token }}" }
          ]
        },
        "options": {}
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.3,
      "position": [-1500, 400],
      "id": "wf2-tags-contato",
      "name": "Tags Contato"
    },
    {
      "parameters": {
        "jsCode": "// panel_id e step_id vêm das Entradas (informados por você).\n// As etiquetas são resolvidas por NOME (palavra-chave). Saída ACHATADA p/ o node nativo.\nconst entradas = $('Entradas').first().json;\n\nconst painelResp = $('Tags Card Painel').first().json;\nconst cardTags = painelResp.tags || [];\nconst contatoResp = $('Tags Contato').first().json;\nconst contatoTags = Array.isArray(contatoResp) ? contatoResp : (contatoResp.items ?? []);\n\nconst norm = (s) => (s || '').normalize('NFD').replace(/[\\u0300-\\u036f]/g, '').toLowerCase().trim();\nconst achar = (tags, kw) => tags.filter(t => norm(t.name).includes(kw));\n\nconst REGRAS = [ { p: 'fb', kw: 'facebook' }, { p: 'ig', kw: 'instagram' }, { p: 'org', kw: 'organico' } ];\nconst ROTULO = { fb: 'Facebook', ig: 'Instagram', org: 'Organico' };\n\nconst out = {\n  helena_company_id: entradas.companyId,\n  nome: (entradas.nome && entradas.nome.trim()) ? entradas.nome.trim() : 'Sem nome',\n  helena_token: entradas.helena_token,\n  panel_id: entradas.panel_id,\n  step_id: entradas.step_id,\n  back_panel_id: entradas.back_panel_id,\n  agendado_step_id: entradas.agendado_step_id,\n  ativo: true\n};\n\nconst avisos = [];\nfor (const r of REGRAS) {\n  const card = achar(cardTags, r.kw);\n  const contato = achar(contatoTags, r.kw);\n  if (card.length !== 1) avisos.push(`Tag CARD ${ROTULO[r.p]}: ${card.length} candidata(s) -> ${card.map(t=>t.name).join(' | ') || 'nenhuma'}`);\n  if (contato.length !== 1) avisos.push(`Tag CONTATO ${ROTULO[r.p]}: ${contato.length} candidata(s) -> ${contato.map(t=>t.name).join(' | ') || 'nenhuma'}`);\n  out[`${r.p}_tag_nome`] = ROTULO[r.p];\n  out[`${r.p}_panel_tag_id`] = card[0]?.id ?? null;\n  out[`${r.p}_contact_tag_id`] = contato[0]?.id ?? null;\n}\nout.status_obs = avisos.length ? avisos.join(' | ') : 'ok';\nout._avisos = avisos;\nout._resumo = { panel_id: entradas.panel_id, step_id: entradas.step_id };\n\nreturn [{ json: out }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [-1260, 400],
      "id": "wf2-montar",
      "name": "Montar Linha"
    },
