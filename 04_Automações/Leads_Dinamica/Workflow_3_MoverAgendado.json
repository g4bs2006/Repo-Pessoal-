        "url": "https://api.wts.chat/crm/v1/panel/card",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "Authorization", "value": "=Bearer {{ $('Validar Config').first().json.token }}" },
            { "name": "Content-Type", "value": "application/json" }
          ]
