      "name": "Tags Painel Full",
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "method": "GET",
        "url": "=https://api.wts.chat/crm/v1/panel/card?PanelId={{ $('Validar Config').first().json.full_panel_id }}&ContactId={{ $('Validar Config').first().json.contactId }}&IncludeArchived=false&OrderBy=CreatedAt&OrderDirection=DESCENDING&PageSize=5",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "Authorization", "value": "=Bearer {{ $('Validar Config').first().json.token }}" }
          ]
        },
        "options": {}
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.3,
      "position": [-920, 320],
      "id": "wf3-cards-full",
      "name": "Cards no FULL",
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "jsCode": "const v = $('Validar Config').first().json;\nconst norm = (s) => (s || '').normalize('NFD').replace(/[\\u0300-\\u036f]/g, '').toLowerCase().trim();\n\n// --- Card BACK (tags reais + descricao/titulo) ---\nconst backCard = $('Get Card Back').first().json || {};\nlet backTagIds = Array.isArray(backCard.tagIds) ? backCard.tagIds\n  : (Array.isArray(backCard.tags) ? backCard.tags.map(t => (t && (t.id || t))).filter(Boolean) : []);\nconst title = backCard.title ?? v.title ?? 'Lead';\nconst backDesc = backCard.description ?? v.description ?? '';\n\n// --- Mapas de tags por nome (tags sao por painel) ---\nconst backPanelTags = (($('Tags Painel Back').first().json) || {}).tags || [];\nconst backIdToName = {}; backPanelTags.forEach(t => { backIdToName[t.id] = t.name; });\nconst fullPanelTags = (($('Tags Painel Full').first().json) || {}).tags || [];\nconst fullNameToId = {}; fullPanelTags.forEach(t => { fullNameToId[norm(t.name)] = t.id; });\n\n// --- Espelha tags do back -> ids do FULL (por nome) ---\nconst mirroredTagIds = [];\nfor (const tid of backTagIds) {\n  const nm = norm(backIdToName[tid] || '');\n  const fullId = nm ? fullNameToId[nm] : null;\n  if (fullId && !mirroredTagIds.includes(fullId)) mirroredTagIds.push(fullId);\n}\n\n// --- Card existente no FULL ---\nconst resp = $('Cards no FULL').first().json;\nconst arr = Array.isArray(resp) ? resp : (resp.items ?? resp.data ?? resp.cards ?? []);\nconst card = (Array.isArray(arr) && arr.length) ? arr[0] : null;\nconst hasCard = !!card;\nconst fullCardId = hasCard ? (card.id ?? null) : null;\nconst currentStepId = hasCard ? (card.stepId ?? null) : null;\nconst existingTagIds = hasCard && Array.isArray(card.tagIds) ? card.tagIds : [];\nconst existingDesc = hasCard ? (card.description || '') : '';\nconst alreadyAgendado = hasCard && currentStepId === v.agendado_step_id;\n\n// --- Merge (mover sem perder) ---\nconst mergedTagIds = Array.from(new Set([...existingTagIds, ...mirroredTagIds]));\nlet mergedDesc = backDesc || '';\nif (existingDesc && backDesc && !existingDesc.includes(backDesc)) mergedDesc = existingDesc + '\\n\\n— Agendamento (IA) —\\n' + backDesc;\nelse if (existingDesc && !backDesc) mergedDesc = existingDesc;\n\nreturn [{ json: { hasCard, fullCardId, currentStepId, alreadyAgendado, contactId: v.contactId, title, mirroredTagIds, mergedTagIds, backDesc, mergedDesc } }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [-700, 320],
      "id": "wf3-preparar",
      "name": "Preparar Espelho"
    },
