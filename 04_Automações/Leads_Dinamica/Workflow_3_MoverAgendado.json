    },
    {
      "parameters": {
        "method": "PUT",
        "url": "=https://api.wts.chat/crm/v2/panel/card/{{ $('Preparar Espelho').first().json.fullCardId }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "Authorization", "value": "=Bearer {{ $('Validar Config').first().json.token }}" },
            { "name": "Content-Type", "value": "application/json" }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"fields\": [\"stepId\", \"tagIds\", \"description\"],\n  \"stepId\": \"{{ $('Validar Config').first().json.agendado_step_id }}\",\n  \"tagIds\": {{ JSON.stringify($('Preparar Espelho').first().json.mergedTagIds) }},\n  \"description\": {{ JSON.stringify($('Preparar Espelho').first().json.mergedDesc) }}\n}",
        "options": {}
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.3,
      "position": [-40, 120],
      "id": "wf3-mover",
