        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"panelId\": \"{{ $('Validar Config').first().json.full_panel_id }}\",\n  \"stepId\": \"{{ $('Validar Config').first().json.agendado_step_id }}\",\n  \"title\": {{ JSON.stringify($('Preparar Espelho').first().json.title) }},\n  \"description\": {{ JSON.stringify($('Preparar Espelho').first().json.backDesc) }},\n  \"contactIds\": [\"{{ $('Preparar Espelho').first().json.contactId }}\"],\n  \"tagIds\": {{ JSON.stringify($('Preparar Espelho').first().json.mirroredTagIds) }}\n}",
        "options": {}
      },
