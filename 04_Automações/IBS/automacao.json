      ],
      "id": "f579d992-be69-4e29-8bfd-71634d0bc5a3",
      "name": "Etiqueta Meta",
      "webhookId": "prime-wh-001"
    },
    {
      "parameters": {
        "jsCode": "// Evento SESSION_NEW (lead novo): dados em body.content. Também aceita o formato antigo.\nconst b = $input.first().json.body ?? $input.first().json;\nconst c = b.content ?? b;\n\nconst companyId = c.companyId ?? b.companyId ?? null;\nconst contactId = c.contactId ?? c.contactDetails?.id ?? c.contact?.id ?? null;\nconst contactName = c.contactDetails?.name ?? c.contact?.name ?? 'Sem nome';\nconst sessionId = c.id ?? c.sessionId ?? c.session?.id ?? null;\nconst platform = (c.channelDetails?.platform ?? c.channel?.platform ?? c.channelType ?? '').toString().toUpperCase();\nconst utm = c.utm ?? c.session?.utm ?? null;\nconst utmSource = (utm && utm.source) ? String(utm.source).toUpperCase() : null;\n\n// Capturando Headline e Campaign\nconst headline = (utm && utm.headline) ? utm.headline : null;\nconst campaign = (utm && utm.campaign) ? utm.campaign : null;\n\nconst lastContactMessage = c.lastMessageText ?? c.lastContactMessage ?? c.lastMessagesAggregated?.text ?? '';\n\n// Deteccao da campanha especial 'Implantes Dentarios em Goiania': lastMessageText vem null no SESSION_NEW, entao a checagem usa apenas o headline do UTM\nconst headlineMatch = (headline || '').trim() === 'Implantes Dentários em Goiânia';\nconst tagEspecialId = headlineMatch ? 'df07b4fb-7d49-454d-99a7-e932f9441ac2' : null;\n\nconst origemRaw = (utmSource ?? platform ?? 'DESCONHECIDO');\nlet origem;\nif (origemRaw.includes('INSTAGRAM')) origem = 'INSTAGRAM';\nelse if (origemRaw.includes('FACEBOOK')) origem = 'FACEBOOK';\nelse origem = 'ORGANICO';\n\nconst agora = new Date();\nconst dataEntrada = agora.toLocaleDateString('pt-BR', { timeZone: 'America/Sao_Paulo' });\nconst horaEntrada = agora.toLocaleTimeString('pt-BR', { timeZone: 'America/Sao_Paulo', hour: '2-digit', minute: '2-digit' });\n\n// Montando a descrição perfeitamente APENAS com Entrada e Headline\nlet descricao = `Entrada: ${dataEntrada} às ${horaEntrada}`;\nif (headline) descricao += `\\nHeadline: ${headline}`;\n\nreturn [{ json: { companyId, contactId, contactName, sessionId, platform, utmSource, origem, campaign, headline, lastContactMessage, tagEspecialId, dataEntrada, horaEntrada, descricao } }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        752,
