    {
      "parameters": {
        "jsCode": "const config = $('Resolver Config').first().json;\nconst card = $('Tem Card?').first().json;\n\n// Montando o texto de forma limpa, sem usar \\n manual\nconst desc = `Nova Entrada: ${config.dataEntrada} às ${config.horaEntrada}\nOrigem: ${config.origem_aplicada}\nCampanha: ${config.campaign || \"Não identificada\"}\nHeadline: ${config.headline || \"Não identificada\"}\nMensagem: ${config.lastContactMessage || \"\"}\n\n--- Histórico Anterior ---\n${(card.oldDesc || \"\").replace(\"Entrada:\", \"Entrada Anterior:\")}`;\n\nreturn [{\n  json: {\n    // Mandamos com inicial maiúscula e minúscula para garantir que a API C# aceite!\n    title: config.contactName,\n    Title: config.contactName,\n    description: desc,\n    Description: desc,\n    panelId: config.panel_id,\n    stepId: config.step_id\n  }\n}];"
      },
