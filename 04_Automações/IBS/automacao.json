    {
      "parameters": {
        "jsCode": "const resp = $input.first().json;\nconst arr = Array.isArray(resp) ? resp : (resp.items ?? resp.data ?? resp.cards ?? []);\nconst hasCard = Array.isArray(arr) && arr.length > 0;\nconst cardId = hasCard ? (arr[0].id ?? arr[0].cardId ?? null) : null;\n// Capturando a descrição antiga para não perdermos o histórico!\nconst oldDesc = hasCard ? (arr[0].description ?? '') : '';\n\nreturn [{ json: { hasCard, cardId, oldDesc } }];"
      },
