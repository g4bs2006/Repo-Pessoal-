      "parameters": {
        "jsCode": "const body = $input.item.json.body || $input.item.json;\nconst tr = body.telefone_cliente || body.telefone_contato || body.telefone || '';\nconst tl = tr.toString().replace(/\\D/g, '');\nconst np = body.nome_cliente || body.nome_contato || 'Paciente';\nconst ins = body.insistiu === true || body.insistiu === 'true';\nconst TZ = 'America/Sao_Paulo';\n\nfunction acharIdAtendimento(o) {\n    for (const key of Object.keys(o)) {\n        const norm = key.toLowerCase().replace(/[^a-z]/g, '');\n        if (norm.includes('atendi') && norm.includes('id') && o[key]) {\n            return o[key].toString();\n        }\n    }\n    return '';\n}\n\nconst H_Seg_M = { ini: { h: 9, m: 0 }, fim: { h: 12, m: 0 } };\nconst H_Seg_T = { ini: { h: 13, m: 0 }, fim: { h: 18, m: 0 } };\nconst H_TS_M  = { ini: { h: 8, m: 0 }, fim: { h: 12, m: 0 } };\nconst H_TS_T  = { ini: { h: 13, m: 0 }, fim: { h: 18, m: 0 } };\nconst H_Sab_M = { ini: { h: 8, m: 0 }, fim: { h: 12, m: 0 } };\nconst F = null;\n\nconst RS = { \n    1: { manha: H_Seg_M, tarde: H_Seg_T }, \n    2: { manha: H_TS_M, tarde: H_TS_T }, \n    3: { manha: H_TS_M, tarde: H_TS_T }, \n    4: { manha: H_TS_M, tarde: H_TS_T }, \n    5: { manha: H_TS_M, tarde: H_TS_T },\n    6: { manha: H_Sab_M, tarde: F },\n    7: F\n};\n\nconst CFG = {\n    estabelecimento_id: '4321',\n    funcionario_id: 86517,\n    funcionario_pessoa_id: 10273502,\n    funcionario_nome: 'Dra. Isadora Corriel Fávaro',\n    sala_id: 30141,\n    nome_unidade: 'Elegance Sorriso CG',\n    nome_empresa: 'Elegance Sorriso CG',\n    nome_loja: 'Elegance Sorriso CG',\n    duracao_servico: 30,\n    capacidade_simultanea: 1,\n    regras_horario: RS,\n    timezone: TZ,\n    api_user: 'daniel.soares1',\n    api_pass: 'Eleganceuni4@',\n    helena_token: 'pn_Ok3QmLxWKurMTIR15XGDuuduwqipKTYi8L3AKcjXdXA',\n    tag_cliente_agendou_ia_id: 'e1af7a84-efa6-4337-b909-9f648094f9e8',\n    limite_dias_busca_normal: 7\n};\n\nconst hj = DateTime.now().setZone(TZ);\nconst di = hj.toFormat('yyyy-MM-dd');\nconst dr = body.data_alvo || body.data_iso || body.data_inicio || body.data_agendada || '';\n\nlet dtP = null;\nif (dr) {\n    dtP = DateTime.fromISO(dr, { zone: TZ });\n    if (!dtP.isValid) dtP = DateTime.fromFormat(dr, 'yyyy-MM-dd HH:mm', { zone: TZ });\n    if (!dtP.isValid) dtP = DateTime.fromFormat(dr, 'dd/MM/yyyy HH:mm', { zone: TZ });\n    if (!dtP.isValid) dtP = DateTime.fromFormat(dr, 'dd/MM/yyyy', { zone: TZ });\n    if (!dtP.isValid) dtP = DateTime.fromFormat(dr, 'yyyy-MM-dd', { zone: TZ });\n}\n\nconst hISO = (dtP && dtP.isValid && (dtP.hour > 0 || dtP.minute > 0)) ? dtP.toFormat('HH:mm') : '';\nconst hF = (body.horario_agendado && body.horario_agendado.length >= 4) ? body.horario_agendado : (body.horario && body.horario.length >= 4) ? body.horario : hISO;\n\nlet dtF = (dtP && dtP.isValid) ? dtP : hj;\nif (dtF.startOf('day') < hj.startOf('day')) dtF = hj;\n\nconst dF = dtF.toFormat('dd/MM/yyyy');\nconst dFISO = dtF.toFormat('yyyy-MM-dd');\nconst dfim = dtF.plus({ days: CFG.limite_dias_busca_normal }).toFormat('yyyy-MM-dd');\n\nreturn {\n    json: {\n        acao_fluxo: body.action || body.acao_fluxo,\n        id_atendimento: body.id_atendimento || body.atendimento_id || body.session_id || body.sessionId || acharIdAtendimento(body) || '',\n        nome_paciente: np,\n        telefone_limpo: tl,\n        insistiu: ins,\n        data_nascimento: body.data_nascimento || '',\n        data_inicio: di,\n        data_agendada: dF,\n        data_agendada_iso: dFISO,\n        data_antiga: body.data_antiga || body['data-antiga'] || '',\n        data_antiga_iso: body.data_antiga_iso || body.data_antiga || '',\n        data_fim: dfim,\n        horario_agendado: hF,\n        spin: body.SPIN || body.spin || null,\n        config_agenda: CFG\n    }\n};\n"
      },
