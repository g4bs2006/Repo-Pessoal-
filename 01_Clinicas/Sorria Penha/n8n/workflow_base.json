        "jsCode": "const resposta = $input.first().json;\nconst items = resposta.items ?? [];\n\nif (items.length === 0) throw new Error('Nenhum card encontrado para esse contato no painel');\n\nconst card = items[0];\nconst cardId = card.id;\n\n// Tags que já existem no card — preserva todas\nconst tagsExistentes = card.tagIds ?? [];\n\n// Tag nova a adicionar (etiqueta do painel CRM)\nconst TAG_NOVA = '3cea9f38-b1f5-4601-85b0-d025b68de781';\n\n// Merge: mantém as existentes + adiciona a nova sem duplicar\nconst tagsFinal = [...new Set([...tagsExistentes, TAG_NOVA])];\n\nconst d = $('Extrair Dados do Payload1').first().json;\n\nconst descricao = [\n  `📅 CONSULTA AGENDADA`,\n  `Data/Hora: ${d.agendamento}`,\n  ``,\n  `👤 LEAD`,\n  `Nome: ${d.nomeCliente}`,\n  `Telefone: ${d.telefone}`,\n  ``,\n  `📋 RESUMO DA CONVERSA`,\n  d.resumoRapido,\n  ``,\n  `🎯 STATUS & ESTÁGIO`,\n  `Status: ${d.statusAtual}`,\n  `Estágio parado: ${d.estagioParado}`,\n  ``,\n  `🦷 DOR PRINCIPAL`,\n  d.dorPrincipal,\n  ``,\n  `🔜 INSTRUÇÃO PARA O FUTURO`,\n  d.instrucao,\n  ``,\n  `─────────────────────────`,\n  `✅ Movimentado pela IA em ${d.dataMovimento} às ${d.horaMovimento}`\n].join('\\n');\n\nconst requestBody = {\n  fields: ['StepId', 'Description', 'TagIds'],\n  stepId: '91e1d71a-0d44-4dbf-8942-b94603b23afa',\n  description: descricao,\n  tagIds: tagsFinal\n};\n\nreturn [{ json: { cardId, requestBody, contactId: d.contactId } }];"
