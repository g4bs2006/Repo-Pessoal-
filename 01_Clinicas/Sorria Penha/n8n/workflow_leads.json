        "url": "=https://api.wts.chat/crm/v1/panel/card?PanelId={{ $('Validar Config').first().json.full_panel_id }}&ContactId={{ $('Validar Config').first().json.contactId }}&IncludeArchived=false&OrderBy=CreatedAt&OrderDirection=DESCENDING&PageSize=5",
