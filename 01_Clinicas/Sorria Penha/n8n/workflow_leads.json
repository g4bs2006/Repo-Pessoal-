    {
      "parameters": {
        "jsCode": "// Payload real do PANEL_CARD_NEW: tudo em body.content.\nconst b = $input.first().json.body ?? $input.first().json;\nconst c = b.content ?? {};\nconst companyId = c.companyId ?? b.companyId ?? null;\nconst cardId = c.id ?? null;\nconst panelId_evt = c.panelId ?? null;\nconst title = c.title ?? null;\nconst description = c.description ?? null;\nconst contacts = Array.isArray(c.contacts) ? c.contacts : [];\nconst contactId = contacts.length ? contacts[0].id : null;\nreturn [{ json: { companyId, cardId, panelId_evt, title, description, contactId } }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -5952,
        3616
      ],
      "id": "1b2f6901-15c5-4d5d-99f0-2a77003f5e3d",
      "name": "Extrair Evento"
    },
    {
      "parameters": {
        "jsCode": "const ev = $('Extrair Evento').first().json;\nconst row = $input.first().json || {};\nconst ativoBool = (row.ativo === true || String(row.ativo).toLowerCase() === 'true');\nconst okCfg = !!row.helena_company_id && ativoBool && !!row.back_panel_id && !!row.agendado_step_id;\nconst isBack = okCfg && ev.panelId_evt === row.back_panel_id;\nconst proceed = okCfg && isBack && !!ev.contactId && !!ev.cardId;\nreturn [{ json: {\n  ...ev,\n  found: proceed,\n  token: row.helena_token,\n  full_panel_id: row.panel_id,\n  agendado_step_id: row.agendado_step_id,\n  back_panel_id: row.back_panel_id\n} }];"
      },
