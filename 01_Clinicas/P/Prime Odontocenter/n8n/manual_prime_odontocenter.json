    {
      "parameters": {
        "jsCode": "const m = $('Montar Linha1').first().json;\nconst avisos = m._avisos || [];\nreturn [{ json: {\n  resumo: m._resumo,\n  clinica: m.nome,\n  helena_company_id: m.helena_company_id,\n  avisos,\n  acao_necessaria: avisos.length ? 'Revisar/corrigir os IDs de etiqueta (status_obs) na tabela automacao_clinicas.' : 'Nenhuma. Config completa.'\n} }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        240,
        64
      ],
      "id": "9b876bfe-a0c0-4c00-a50a-cb4eea4ac0e0",
      "name": "Resultado"
    },
    {
      "parameters": {
        "jsCode": "const entradas = $('Entradas').first().json;\nconst norm = (s) => (s || '').normalize('NFD').replace(/[\\u0300-\\u036f]/g, '').toLowerCase().trim();\n\n// Coleta robusta: alguns endpoints do Helena retornam ARRAY no topo, e o n8n\n// quebra isso em vários itens. Este helper reúne tudo, seja qual for o formato.\nfunction coletar(nodeName) {\n  const items = $(nodeName).all().map(i => i.json);\n  if (items.length === 1) {\n    const j = items[0];\n    if (Array.isArray(j)) return j;\n    if (j && Array.isArray(j.items)) return j.items;\n    if (j && Array.isArray(j.data)) return j.data;\n  }\n  return items;\n}\n\n// --- STEPS (painel = objeto único; ignora arquivados) ---\nconst painelSteps = $('Steps Painel').first().json;\nconst steps = (painelSteps.steps || []).filter(s => !s.archived);\nconst acharStep = (kw) => steps.filter(s => norm(s.title) === kw);\n\n// --- CUSTOM FIELDS (endpoint devolve array -> coletar) ---\nconst campos = coletar('Campos Painel');\nconst acharCampo = (kw) => campos.filter(c => norm(c.name).includes(kw));\n\n// --- TAGS de card (painel = objeto único, tags em .tags) ---\nconst cardTags = ($('Tags Card Painel').first().json.tags) || [];\nconst acharCard = (fn) => cardTags.filter(fn);\n\n// --- TAGS de contato (endpoint devolve array -> coletar) ---\nconst contatoTags = coletar('Tags Contato');\nconst acharContato = (fn) => contatoTags.filter(fn);\n\nconst avisos = [];\nconst um = (arr, rotulo) => { if (arr.length !== 1) avisos.push(`${rotulo}: ${arr.length} candidata(s) -> ${arr.map(t=>t.title||t.name).join(' | ') || 'nenhuma'}`); return arr[0] || null; };\n\n// steps\nconst sLeads      = um(acharStep('leads'),      'Etapa Leads');\nconst sAgendados  = um(acharStep('agendados'),  'Etapa Agendados');\nconst sCancelados = um(acharStep('cancelados'), 'Etapa Cancelados');\n\n// custom fields\nconst cAgEm   = um(acharCampo('agendado em'),   'Campo Agendado em');\nconst cAgPara = um(acharCampo('agendado para'), 'Campo Agendado para');\n\n// tag card \"IA\" (nome exato) e tag contato \"Agendou IA\" (contains)\nconst tagIaCard  = um(acharCard(t => norm(t.name) === 'ia'), 'Tag card IA');\nconst tagAgendCt = um(acharContato(t => norm(t.name).includes('agendou ia')), 'Tag contato Agendou IA');\n\n// tags de origem (card + contato) por palavra-chave\nconst REGRAS = [ { p:'fb', kw:'facebook' }, { p:'ig', kw:'instagram' }, { p:'org', kw:'organico' } ];\nconst ROTULO = { fb:'Facebook', ig:'Instagram', org:'Organico' };\n\nconst out = {\n  helena_company_id: entradas.companyId,\n  nome: (entradas.nome && entradas.nome.trim()) ? entradas.nome.trim() : 'Sem nome',\n  helena_token: entradas.helena_token,\n  panel_id: entradas.panel_id,\n  back_panel_id: entradas.back_panel_id ?? null,\n  step_id: sLeads?.id ?? null,\n  agendado_step_id: sAgendados?.id ?? null,\n  cancelado_step_id: sCancelados?.id ?? null,\n  ia_card_tag_id: tagIaCard?.id ?? null,\n  agendado_contact_tag_id: tagAgendCt?.id ?? null,\n  agendado_em_field_key: cAgEm?.key ?? null,\n  agendado_para_field_key: cAgPara?.key ?? null,\n  ativo: true\n};\n\nfor (const r of REGRAS) {\n  const card = acharCard(t => norm(t.name).includes(r.kw));\n  const contato = acharContato(t => norm(t.name).includes(r.kw));\n  if (card.length !== 1) avisos.push(`Tag CARD ${ROTULO[r.p]}: ${card.length} candidata(s)`);\n  out[`${r.p}_tag_nome`] = ROTULO[r.p];\n  out[`${r.p}_panel_tag_id`] = card[0]?.id ?? null;\n  out[`${r.p}_contact_tag_id`] = contato[0]?.id ?? null;\n}\n\nout.status_obs = avisos.length ? avisos.join(' | ') : 'ok';\nout._avisos = avisos;\nout._resumo = { panel_id: entradas.panel_id, step_id: out.step_id, agendado_step_id: out.agendado_step_id, cancelado_step_id: out.cancelado_step_id, agendado_em_field_key: out.agendado_em_field_key, agendado_para_field_key: out.agendado_para_field_key };\nreturn [{ json: out }];"
      },
