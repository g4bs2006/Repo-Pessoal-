      "parameters": {
        "jsCode": "const payload = $input.first().json.body ?? $input.first().json;\n\nconst contactId = payload.contact?.id;\nconst contactName = payload.contact?.name ?? 'Sem nome';\nconst sessionId = payload.sessionId ?? payload.session?.id;\nconst platform = payload.channel?.platform?.toUpperCase();\nconst utmSource = payload.session?.utm?.source?.toUpperCase() ?? null;\nconst headline = payload.questions?.headline ?? null;\n\n// ✅ utmSource tem prioridade sobre platform\nconst origem = utmSource ?? platform ?? 'DESCONHECIDO';\n\nlet tagName;\nif (origem.includes('FACEBOOK'))       tagName = 'FACEBOOK';\nelse if (origem.includes('INSTAGRAM')) tagName = 'INSTAGRAM';\nelse if (origem.includes('GOOGLE'))    tagName = 'GOOGLE';\nelse                                    tagName = 'ORGÂNICO';\n\nconst stepId  = 'cbcbffdc-eb1a-41c5-b985-0dd65150fbfc';\nconst panelId = '09e6e9bb-24b4-46d1-b8e4-0c4559423edc';\nconst position = Date.now();\n\nconst agora = new Date();\nconst dataEntrada = agora.toLocaleDateString('pt-BR', { timeZone: 'America/Sao_Paulo' });\nconst horaEntrada = agora.toLocaleTimeString('pt-BR', { timeZone: 'America/Sao_Paulo', hour: '2-digit', minute: '2-digit' });\n\nlet descricao = `Entrada: ${dataEntrada} às ${horaEntrada}`;\nif (headline) {\n  descricao += `\\nCampanha: ${headline}`;\n}\n\nreturn [{ json: { contactId, contactName, sessionId, platform, utmSource, tagName, stepId, panelId, position, descricao } }];"
      },
