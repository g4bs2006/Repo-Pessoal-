    {
      "parameters": {
        "jsCode": "// Tags de card são POR PAINEL na Helena → espelha por NOME (tolerante a acento/maiúsculas).\nconst prep = $('Preparar Evento').first().json;\nconst norm = s => String(s ?? '').normalize('NFD').replace(/[\\u0300-\\u036f]/g, '').trim().toUpperCase();\nconst destTags = ($input.first().json.tags) || [];\nconst porNome = new Map(destTags.map(t => [norm(t.name), t.id]));\nconst targetTagIds = [];\nconst tagsSemEquivalente = [];\nfor (const nome of (prep.tagNames || [])) {\n  const id = porNome.get(norm(nome));\n  if (id) targetTagIds.push(id); else tagsSemEquivalente.push(nome);\n}\nreturn [{ json: { ...prep, targetTagIds, tagsSemEquivalente: tagsSemEquivalente.join(', ') } }];"
      },
