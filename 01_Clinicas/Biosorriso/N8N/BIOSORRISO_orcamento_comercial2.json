      "parameters": {
        "jsCode": "// Evento PANEL_CARD_STEP_CHANGE: dados em body.content. Gate por IDs fixos (sem busca por nome).\nconst CONFIG = {\n  token: 'pn_lveIqFdsp0MADkdhSN12VBIevVdWKPYvNdGR8wHYA',\n  // Origem: painel '🎯 | Controle de Leads', etapa 'Orçamento em Aberto'\n  sourcePanelId: '86675c54-e8ba-4a30-b3e8-05c0e90f64f4',\n  sourceStepId: '5d6ddd48-b731-4e6d-adea-55efb2f35bf0',\n  // Destino: painel '💰 | Orçamentos - Comercial 2', etapa 'Orçamento em Aberto'\n  targetPanelId: '1157208a-aa6d-4004-993d-5c4bd02accbd',\n  targetStepId: 'c1077fe4-0586-428d-8699-d0dbe600571f'\n};\n\nconst b = $input.first().json.body ?? $input.first().json;\nconst c = b.content ?? b;\nconst eventType = b.eventType ?? null;\n\nconst cardId = c.id ?? null;\nconst panelId = c.panelId ?? null;\nconst stepId = c.stepId ?? null;\nconst panelTitle = c.panelTitle ?? '';\nconst stepTitle = c.stepTitle ?? '';\nconst title = c.title ?? 'Sem título';\nconst description = c.description ?? '';\nconst monetaryAmount = (typeof c.monetaryAmount === 'number') ? c.monetaryAmount : null;\nconst contactIds = Array.isArray(c.contacts) ? c.contacts.map(x => x.id).filter(Boolean) : [];\nconst tagNames = Array.isArray(c.tags) ? c.tags.map(x => x.text).filter(Boolean) : [];\n\nconst match = eventType === 'PANEL_CARD_STEP_CHANGE'\n  && panelId === CONFIG.sourcePanelId\n  && stepId === CONFIG.sourceStepId;\n\nconst agora = new Date();\nconst quando = agora.toLocaleDateString('pt-BR', { timeZone: 'America/Sao_Paulo' }) + ' às ' + agora.toLocaleTimeString('pt-BR', { timeZone: 'America/Sao_Paulo', hour: '2-digit', minute: '2-digit' });\nconst descricaoDestino = (description ? description + '\\n' : '') + 'Origem: ' + panelTitle + ' (espelhado automaticamente em ' + quando + ')';\n\nreturn [{ json: { match, eventType, cardId, panelId, stepId, panelTitle, stepTitle, title, description, descricaoDestino, monetaryAmount, contactIds, tagNames, token: CONFIG.token, targetPanelId: CONFIG.targetPanelId, targetStepId: CONFIG.targetStepId } }];"
      },
