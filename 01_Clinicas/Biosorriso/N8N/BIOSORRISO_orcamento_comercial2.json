    },
    {
      "parameters": {
        "jsCode": "const resp = $input.first().json;\nconst arr = Array.isArray(resp) ? resp : (resp.items ?? resp.data ?? resp.cards ?? []);\nconst temContato = ($('Preparar Evento').first().json.contactIds ?? []).length > 0;\nconst hasCard = temContato && Array.isArray(arr) && arr.length > 0;\nconst cardId = hasCard ? (arr[0].id ?? arr[0].cardId ?? null) : null;\n// União: tags que o card já tem no destino + tags espelhadas do painel de origem (mapeadas por nome)\nconst tagIdsAtuais = hasCard ? (arr[0].tagIds ?? []) : [];\nconst mapeadas = $('Mapear Tags').first().json.targetTagIds ?? [];\nconst tagIdsFinais = [...new Set([...tagIdsAtuais, ...mapeadas])];\nreturn [{ json: { hasCard, cardId, tagIdsFinais } }];"
