{
  "nodes": [
    {
      "parameters": {
        "jsCode": "// Evento SESSION_NEW (lead novo): dados em body.content. Também aceita o formato antigo.\nconst b = $input.first().json.body ?? $input.first().json;\nconst c = b.content ?? b;\n\nconst companyId = c.companyId ?? b.companyId ?? null;\nconst contactId = c.contactId ?? c.contactDetails?.id ?? c.contact?.id ?? null;\nconst contactName = c.contactDetails?.name ?? c.contact?.name ?? 'Sem nome';\nconst sessionId = c.id ?? c.sessionId ?? c.session?.id ?? null;\nconst platform = (c.channelDetails?.platform ?? c.channel?.platform ?? c.channelType ?? '').toString().toUpperCase();\nconst utm = c.utm ?? c.session?.utm ?? null;\nconst utmSource = (utm && utm.source) ? String(utm.source).toUpperCase() : null;\nconst headline = (utm && utm.headline) ? utm.headline : null;\n// Na Helena, utm.campaign = ID numérico do anúncio Meta (igual a sourceId), não o nome da campanha.\n// O legível é o headline (título do anúncio), que se repete entre anúncios — por isso gravamos 'headline (adId)'.\nconst adId = utm ? (utm.sourceId ?? utm.campaign ?? null) : null;\nconst campanha = utm ? ([headline, adId ? '(' + adId + ')' : null].filter(Boolean).join(' ') || null) : null;\nconst lastContactMessage = c.lastMessageText ?? c.lastContactMessage ?? c.lastMessagesAggregated?.text ?? '';\n\nconst origemRaw = (utmSource ?? platform ?? 'DESCONHECIDO');\nlet origem;\nif (origemRaw.includes('INSTAGRAM')) origem = 'INSTAGRAM';\nelse if (origemRaw.includes('FACEBOOK')) origem = 'FACEBOOK';\nelse origem = 'ORGANICO';\n\nconst trafegoPago = origem === 'FACEBOOK' || origem === 'INSTAGRAM';\n\nconst agora = new Date();\nconst dataEntrada = agora.toLocaleDateString('pt-BR', { timeZone: 'America/Sao_Paulo' });\nconst horaEntrada = agora.toLocaleTimeString('pt-BR', { timeZone: 'America/Sao_Paulo', hour: '2-digit', minute: '2-digit' });\n\nlet descricao = `Entrada: ${dataEntrada} às ${horaEntrada}`;\nif (campanha) descricao += `\\nCampanha: ${campanha}`;\n\nreturn [{ json: { companyId, contactId, contactName, sessionId, platform, utmSource, origem, headline, adId, campanha, trafegoPago, lastContactMessage, dataEntrada, horaEntrada, descricao } }];\n"
      },
