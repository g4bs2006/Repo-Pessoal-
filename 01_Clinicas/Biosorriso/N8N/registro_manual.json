    {
      "parameters": {
        "jsCode": "const m = $('Montar Linha1').first().json;\nconst avisos = m._avisos || [];\nreturn [{ json: {\n  resumo: m._resumo,\n  clinica: m.nome,\n  helena_company_id: m.helena_company_id,\n  avisos,\n  acao_necessaria: avisos.length ? 'Revisar/corrigir os IDs de etiqueta (status_obs) na tabela automacao_clinicas.' : 'Nenhuma. Config completa.'\n} }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -752,
        2304
      ],
      "id": "dc6a43ba-3c1a-4edb-8896-9dc0937df84c",
      "name": "Resultado"
    },
    {
      "parameters": {
        "jsCode": "// panel_id e step_id vêm das Entradas (informados por você).\n// As etiquetas são resolvidas por NOME (palavra-chave). Saída ACHATADA p/ o node nativo.\nconst entradas = $('Entradas').first().json;\n\nconst painelResp = $('Tags Card Painel').first().json;\nconst cardTags = painelResp.tags || [];\nconst contatoResp = $('Tags Contato').first().json;\nconst contatoTags = Array.isArray(contatoResp) ? contatoResp : (contatoResp.items ?? []);\n\nconst norm = (s) => (s || '').normalize('NFD').replace(/[\\u0300-\\u036f]/g, '').toLowerCase().trim();\nconst achar = (tags, kw) => tags.filter(t => norm(t.name).includes(kw));\n\nconst REGRAS = [ { p: 'fb', kw: 'facebook' }, { p: 'ig', kw: 'instagram' }, { p: 'org', kw: 'organico' } ];\nconst ROTULO = { fb: 'FACEBOOK', ig: 'INSTAGRAM', org: 'ORGÂNICO' };\n\nconst out = {\n  helena_company_id: entradas.companyId,\n  nome: (entradas.nome && entradas.nome.trim()) ? entradas.nome.trim() : 'Sem nome',\n  helena_token: entradas.helena_token,\n  panel_id: entradas.panel_id,\n  step_id: entradas.step_id,\n  back_panel_id: entradas.back_panel_id,\n  agendado_step_id: entradas.agendado_step_id,\n  ativo: true\n};\n\nconst avisos = [];\nfor (const r of REGRAS) {\n  const card = achar(cardTags, r.kw);\n  const contato = achar(contatoTags, r.kw);\n  if (card.length !== 1) avisos.push(`Tag CARD ${ROTULO[r.p]}: ${card.length} candidata(s) -> ${card.map(t=>t.name).join(' | ') || 'nenhuma'}`);\n  if (contato.length !== 1) avisos.push(`Tag CONTATO ${ROTULO[r.p]}: ${contato.length} candidata(s) -> ${contato.map(t=>t.name).join(' | ') || 'nenhuma'}`);\n  out[`${r.p}_tag_nome`] = ROTULO[r.p];\n  out[`${r.p}_panel_tag_id`] = card[0]?.id ?? null;\n  out[`${r.p}_contact_tag_id`] = contato[0]?.id ?? null;\n}\nout.status_obs = avisos.length ? avisos.join(' | ') : 'ok';\nout._avisos = avisos;\nout._resumo = { panel_id: entradas.panel_id, step_id: entradas.step_id };\n\nreturn [{ json: out }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
